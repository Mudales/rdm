{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rdm",
  "version": "0.3.0",
  "identifier": "dev.rdm.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rdm",
        "width": 1180,
        "height": 720,
        "minWidth": 760,
        "minHeight": 460,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Rust Download Manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQkYyNzUwRDI4RDA5MUEKUldRYUNZM1NVQ2UvSU5XeXVRT0NFZ0lGeTdnb1RvaGFyK2RESkVaWTZHWExSUlh0YTNJS01DOFkK",
      "endpoints": [
        "https://github.com/Mudales/rdm/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
