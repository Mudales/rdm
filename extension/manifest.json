{
  "manifest_version": 3,
  "name": "rdm — Rust Download Manager",
  "short_name": "rdm",
  "version": "0.1.0",
  "description": "Send downloads, videos and links to the rdm download manager.",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "rdm@rdm.dev",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "downloads",
    "cookies",
    "storage",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "rdm",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
